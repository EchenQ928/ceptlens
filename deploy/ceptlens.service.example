[Unit]
Description=CeptLens content host
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/ceptlens/current
Environment=NODE_ENV=production
Environment=CEPTLENS_PORT=4173
Environment=CEPTLENS_PUBLIC_ORIGIN=https://ceptlens.com
ExecStart=/usr/bin/npm run host
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
