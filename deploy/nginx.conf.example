server {
    listen 80;
    listen [::]:80;
    server_name ceptlens.com www.ceptlens.com;
    return 301 https://ceptlens.com$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.ceptlens.com;
    ssl_certificate /etc/letsencrypt/live/ceptlens.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ceptlens.com/privkey.pem;
    return 301 https://ceptlens.com$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ceptlens.com;
    ssl_certificate /etc/letsencrypt/live/ceptlens.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ceptlens.com/privkey.pem;
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
    }
}
