{
  "name": "ceptlens",
  "version": "1.0.0",
  "description": "An English-first bilingual learning platform for AI model engineering concepts.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "host": "node server/content-host.mjs",
    "validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:services": "node scripts/verify-services.mjs",
    "check": "npm run validate && npm run test && npm run build && npm run test:services"
  },
  "dependencies": {
    "lucide-react": "1.38.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
